<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp"
    android:background="@color/lightBackground"
    tools:context=".AddNoticeActivity">

    <!-- Title Input -->
    <EditText
        android:id="@+id/et_title"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Enter Notice Title"
        android:background="@drawable/rounded_edittext"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/primaryText"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
       />

    <!-- Description Input -->
    <EditText
        android:id="@+id/et_description"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:hint="Enter Notice Description"
        android:background="@drawable/rounded_edittext"
        android:layout_marginTop="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:gravity="top"
        android:textColor="@color/primaryText"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/et_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
         />

    <!-- Pick Date for Scheduling -->
    <Button
        android:id="@+id/btn_pick_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick Date"
        android:background="@drawable/rounded_button"
        android:layout_marginTop="10dp"

        android:textColor="@android:color/white"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/et_description"
        app:layout_constraintStart_toStartOf="parent"
       />

    <!-- Selected Date Text -->
    <TextView
        android:id="@+id/tv_selected_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No date selected"
        android:textSize="14sp"
        android:textColor="@color/secondaryText"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/btn_pick_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!-- Attach File Button -->
    <Button
        android:id="@+id/btn_attach_file"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Attach File"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_button"
        android:textColor="@android:color/white"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/tv_selected_date"
        app:layout_constraintStart_toStartOf="parent"
         />

    <!-- Attached File Name Text -->
    <TextView
        android:id="@+id/tv_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No file attached"
        android:textSize="14sp"
        android:textColor="@color/secondaryText"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/btn_attach_file"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
         />

    <!-- Submit Button -->
    <Button
        android:id="@+id/btn_submit_notice"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:text="Submit Notice"
        android:background="@drawable/rounded_button_primary"
        android:textColor="@android:color/white"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_file_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
         />

</androidx.constraintlayout.widget.ConstraintLayout>
