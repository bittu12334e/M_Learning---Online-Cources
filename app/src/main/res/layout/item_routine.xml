<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/background_card"
    android:elevation="4dp"
    android:layout_margin="8dp">
    <!-- Routine Title -->
    <TextView
        android:id="@+id/tvRoutineTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Routine Title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <!-- Upload Date Text -->
    <TextView
        android:id="@+id/tvUploadDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Uploaded on: Date"
        android:textSize="14sp"
        android:textColor="#757575"
        android:fontFamily="sans-serif-medium" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="8dp" />

    <!-- Button Layout -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- View File Button -->
        <Button
            android:id="@+id/btnViewFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="View File"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:paddingVertical="8dp" />

        <!-- Edit Routine Button -->
        <Button
            android:id="@+id/btnEditRoutine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Routine"
            android:backgroundTint="#03DAC5"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp"
            android:paddingVertical="8dp" />
    </LinearLayout>

</LinearLayout>
