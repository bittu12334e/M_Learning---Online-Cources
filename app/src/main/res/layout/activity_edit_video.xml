<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/backgroundColor"
    tools:context=".EditVideoActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_edit_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Uploaded Videos"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primaryColor"
        android:gravity="center"
        android:layout_gravity="center"
        android:paddingBottom="16dp" />


    <ListView
        android:id="@+id/listViewVideos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp" />


    <!-- Upload New Video Button -->
    <Button
        android:id="@+id/btnAddNewVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add New Video"
        android:background="@color/primaryColor"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp" />

    <!-- Save Changes Button -->
    <Button
        android:id="@+id/btnSaveVideoChanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Video Changes"
        android:background="@color/primaryColor"
        android:textColor="@android:color/white" />
</LinearLayout>
